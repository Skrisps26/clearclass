build-BriefFunction:
	mkdir -p "$(ARTIFACTS_DIR)"
	cp -R src "$(ARTIFACTS_DIR)/src"
	cp -R policies "$(ARTIFACTS_DIR)/policies"
	cp -R config "$(ARTIFACTS_DIR)/config"

build-ChatFunction:
	mkdir -p "$(ARTIFACTS_DIR)"
	cp -R src "$(ARTIFACTS_DIR)/src"
	cp -R policies "$(ARTIFACTS_DIR)/policies"
	cp -R config "$(ARTIFACTS_DIR)/config"

build-PolicyFunction:
	mkdir -p "$(ARTIFACTS_DIR)"
	cp -R src "$(ARTIFACTS_DIR)/src"
	cp -R policies "$(ARTIFACTS_DIR)/policies"
	cp -R config "$(ARTIFACTS_DIR)/config"
